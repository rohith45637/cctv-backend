# ==============================================================================
# Backend Security Core - Environment Configuration
# ==============================================================================

# Application Environment (development | staging | production | test)
APP_ENV=development
API_PORT=8000
DEBUG=true

# Database Connection (SQLite for local development, PostgreSQL for production)
DATABASE_URL=sqlite:///./security_core.db

# Authentication & Security
# WARNING: In production, generate a secure 64-char key (e.g., openssl rand -hex 32)
JWT_SECRET=dev-insecure-jwt-secret-replace-in-production-only-key-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Integrations
AI_VIDEO_SERVICE_URL=http://localhost:8010
AI_AGENT_SERVICE_URL=http://localhost:8020
REDIS_URL=redis://localhost:6379/0
STORAGE_URL=http://localhost:9000/evidence

# CORS Origins (comma-separated list of permitted frontend URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Demo & Seeding Configuration
DEMO_MODE=true
